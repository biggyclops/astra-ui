import { db } from "./db";
import { asc, eq, gt } from "drizzle-orm";
import { jobs, nodes, messages, media } from "@shared/schema";
import type {
  InsertJob,
  InsertMessage,
  Job,
  Message,
  Node,
  Media,
} from "@shared/schema";

/**
 * Storage layer supports:
 * - DEMO mode (no DB): in-memory store with seeded content
 * - DB mode: Drizzle/Postgres-backed store
 */

class MemoryStorage {
  private _messages: Message[] = [];
  private _jobs: Job[] = [];
  private _nodes: Node[] = [];
  private _media: Media[] = [];

  private msgId = 1;
  private jobId = 1;
  private nodeId = 1;
  private mediaId = 1;

  constructor() {
    this.seedDemo();
  }

  // ---------- Seed ----------
  private seedDemo() {
    if (this._messages.length === 0) {
      this._messages.push(
        {
          id: this.msgId++,
          role: "system",
          content: "Welcome to Astra UI console.",
          type: "text",
          metadata: null,
          createdAt: new Date(),
        } as any,
        {
          id: this.msgId++,
          role: "assistant",
          content: "Node status report:",
          type: "node_status",
          metadata: { name: "Kratos", nodeId: 1, status: "online" },
          createdAt: new Date(),
        } as any
      );
    }

    if (this._nodes.length === 0) {
      this._nodes.push(
        {
          id: this.nodeId++,
          name: "Kratos",
          type: "Kratos",
          status: "online",
          metrics: { cpu: 32, memory: 58 },
          createdAt: new Date(),
          updatedAt: new Date(),
        } as any,
        {
          id: this.nodeId++,
          name: "Hades",
          type: "Hades",
          status: "unknown",
          metrics: { cpu: 0, memory: 0 },
          createdAt: new Date(),
          updatedAt: new Date(),
        } as any,
        {
          id: this.nodeId++,
          name: "Hermes",
          type: "Hermes",
          status: "online",
          metrics: { cpu: 12, memory: 41 },
          createdAt: new Date(),
          updatedAt: new Date(),
        } as any
      );
    }

    if (this._jobs.length === 0) {
      this._jobs.push(
        {
          id: this.jobId++,
          type: "comfyui.image",
          title: "Nebula Render Pipeline",
          status: "done",
          node: "Kratos",
          progress: 100,
          inputs: [],
          outputs: [
            {
              id: "out-1",
              type: "image",
              url: "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=600",
              thumb_url:
                "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=200",
            },
          ],
          logs: ["Job completed successfully."],
          createdAt: new Date(),
          updatedAt: new Date(),
        } as any,
        {
          id: this.jobId++,
          type: "comfyui.video",
          title: "Orbit Simulation v3",
          status: "running",
          node: "Hades",
          progress: 45,
          inputs: [],
          outputs: [],
          logs: ["Initializing...", "Processing frames..."],
          createdAt: new Date(),
          updatedAt: new Date(),
        } as any
      );
    }

    // Seed media too (so Media Wall isn't empty in DEMO mode)
    this.seedDemoMedia();
  }

  private seedDemoMedia() {
    if (this._media.length > 0) return;

    const allTags = [
      "space",
      "nebula",
      "astra",
      "render",
      "simulation",
      "timelapse",
      "orbit",
      "deep-field",
      "spectral",
      "composite",
      "raw",
      "processed",
    ];

    const sampleVideos = [
      "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4",
      "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4",
      "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/Sintel.mp4",
      "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
    ];

    const sampleImages = [
      "https://images.unsplash.com/photo-1462331940025-496dfbfc7564?w=600",
      "https://images.unsplash.com/photo-1444703686981-a3abbc4d4fe3?w=600",
      "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600",
      "https://images.unsplash.com/photo-1534447677768-be436bb09401?w=600",
      "https://images.unsplash.com/photo-1506318137071-a8e063b4bec0?w=600",
      "https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?w=600",
    ];

    const videoThumbs = [
      "https://images.unsplash.com/photo-1618477247222-ac60c6218780?w=400",
      "https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?w=400",
      "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=400",
      "https://images.unsplash.com/photo-1506318137071-a8e063b4bec0?w=400",
    ];

    const videoNames = [
      "Orbit Simulation",
      "Nebula Timelapse",
      "Deep Field Scan",
      "Cluster Formation",
      "Station Flyby",
      "Ring System Render",
    ];
    const imageNames = [
      "Nebula Core",
      "Star Field",
      "Galaxy Arm",
      "Cosmic Web",
      "Spectral Analysis",
      "UV Composite",
      "Thermal Scan",
    ];

    for (let i = 0; i < 60; i++) {
      const isVideo = i % 3 === 0;
      const mtime = new Date(
        Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000
      );

      const tagCount = 1 + Math.floor(Math.random() * 3);
      const tags: string[] = [];
      for (let t = 0; t < tagCount; t++) {
        const tag = allTags[Math.floor(Math.random() * allTags.length)];
        if (!tags.includes(tag)) tags.push(tag);
      }

      const url = isVideo
        ? sampleVideos[i % sampleVideos.length]
        : sampleImages[i % sampleImages.length];

      const thumb_url = isVideo
        ? videoThumbs[i % videoThumbs.length]
        : (null as any);

      const title = isVideo
        ? `${videoNames[i % videoNames.length]} ${String(i).padStart(2, "0")}`
        : `${imageNames[i % imageNames.length]} ${String(i).padStart(2, "0")}`;

      this._media.push(
        {
          id: this.mediaId++,
          title,
          url,
          thumb_url,
          type: isVideo ? "video" : "image",
          mtime,
          tags,
          favorite: Math.random() > 0.8,
          createdAt: new Date(),
          updatedAt: new Date(),
        } as any
      );
    }
  }

  // ---------- Messages ----------
  async getMessages(): Promise<Message[]> {
    return this._messages;
  }

  async getMessagesAfterId(afterId: number): Promise<Message[]> {
    return this._messages.filter((m) => m.id > afterId);
  }

  async createMessage(message: InsertMessage): Promise<Message> {
    const created: Message = {
      id: this.msgId++,
      role: message.role as any,
      content: message.content as any,
      type: (message as any).type ?? "text",
      metadata: (message as any).metadata ?? null,
      createdAt: new Date(),
    } as any;

    this._messages.push(created);
    return created;
  }

  // ---------- Jobs ----------
  async getJobs(): Promise<Job[]> {
    return this._jobs;
  }

  async getJob(id: number): Promise<Job | undefined> {
    return this._jobs.find((j) => j.id === id);
  }

  async createJob(job: InsertJob): Promise<Job> {
    const created: Job = {
      id: this.jobId++,
      ...(job as any),
      createdAt: new Date(),
      updatedAt: new Date(),
    } as any;

    this._jobs.push(created);
    return created;
  }

  async updateJob(
    id: number,
    updates: Partial<Pick<Job, "status" | "progress" | "outputs" | "logs" | "updatedAt">>
  ): Promise<Job | undefined> {
    const idx = this._jobs.findIndex((j) => j.id === id);
    if (idx < 0) return undefined;
    const cur = this._jobs[idx];

    const updated = {
      ...cur,
      ...updates,
      updatedAt: updates.updatedAt ?? new Date(),
    } as Job;

    this._jobs[idx] = updated;
    return updated;
  }

  // ---------- Nodes ----------
  async getNodes(): Promise<Node[]> {
    return this._nodes;
  }

  // ---------- Media ----------
  async getMedia(): Promise<Media[]> {
    // ensure demo media exists
    this.seedDemoMedia();
    return this._media;
  }
}

class DatabaseStorage {
  // ---------- Messages ----------
  async getMessages(): Promise<Message[]> {
    return await db!.select().from(messages).orderBy(asc(messages.id));
  }

  async getMessagesAfterId(afterId: number): Promise<Message[]> {
    return await db!
      .select()
      .from(messages)
      .where(gt(messages.id, afterId))
      .orderBy(asc(messages.id));
  }

  async createMessage(message: InsertMessage): Promise<Message> {
    const [created] = await db!.insert(messages).values(message as any).returning();
    return created;
  }

  // ---------- Jobs ----------
  async getJobs(): Promise<Job[]> {
    return await db!.select().from(jobs);
  }

  async getJob(id: number): Promise<Job | undefined> {
    const [job] = await db!.select().from(jobs).where(eq(jobs.id, id));
    return job;
  }

  async createJob(job: InsertJob): Promise<Job> {
    const [created] = await db!.insert(jobs).values(job as any).returning();
    return created;
  }

  async updateJob(
    id: number,
    updates: Partial<Pick<Job, "status" | "progress" | "outputs" | "logs" | "updatedAt">>
  ): Promise<Job | undefined> {
    const [updated] = await db!
      .update(jobs)
      .set(updates as any)
      .where(eq(jobs.id, id))
      .returning();
    return updated;
  }

  // ---------- Nodes ----------
  async getNodes(): Promise<Node[]> {
    return await db!.select().from(nodes);
  }

  // ---------- Media ----------
  async getMedia(): Promise<Media[]> {
    return await db!.select().from(media);
  }
}

// Export the right storage depending on DB availability
export const storage = db ? new DatabaseStorage() : new MemoryStorage();
