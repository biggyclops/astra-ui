# Application
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/astra

# Hermes / NAS media integration
# Use a local mount when possible for direct streaming.
HERMES_LOCAL_PATH=/mnt/hermes/storage

# Optional remote File Browser / HTTP endpoint.
HERMES_BASE_URL=http://nas-hostname:8080

# Optional File Browser credentials or token.
# Keep real credentials in your local environment only.
HERMES_AUTH=username:password

# Enable verbose Hermes diagnostics when troubleshooting.
HERMES_DEBUG=false
