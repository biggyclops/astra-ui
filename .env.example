# Application
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/astra

# Hermes / NAS media integration
# Use a local mount when possible for direct streaming.
HERMES_LOCAL_PATH=/mnt/hermes/storage

# Optional remote File Browser / HTTP endpoint.
HERMES_BASE_URL=http://nas-hostname:8080

# Optional File Browser credentials or token.
# Keep real credentials in your local environment only.
HERMES_AUTH=username:password

# Enable verbose Hermes diagnostics when troubleshooting.
HERMES_DEBUG=false

# -------------------------
# Authentication
# -------------------------
# All three are required for auth to be enabled. If any are missing,
# the server runs in fail-closed mode (all logins refused, gated routes return 401).

# HMAC-SHA256 key for signing session cookies (any random string, keep secret)
ASTRA_AUTH_SECRET=replace-with-random-secret

# Single allowed username
ASTRA_AUTH_USER=operator

# Password hash. Use scrypt format (recommended) or SHA-256.
# Generate scrypt:
#   node -e "const c=require('crypto');const s=c.randomBytes(32);const k=c.scryptSync('yourpassword',s,64,{N:16384,r:8,p:1});console.log('scrypt:'+s.toString('base64')+':'+k.toString('base64'))"
# Generate SHA-256 (less secure, acceptable for dev):
#   echo -n 'yourpassword' | sha256sum | cut -d' ' -f1
ASTRA_AUTH_PASSWORD_SHA256=scrypt:base64salt:base64key

# Optional: set to 1 to add Secure flag to cookies (requires HTTPS)
# Default off because live serves plain HTTP over Tailscale.
# ASTRA_AUTH_COOKIE_SECURE=1
